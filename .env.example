# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (Supabase > Project Settings > API Keys)

# (también sirven los nombres NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave SECRETA (sb_secret_… o service_role): solo se usa en el servidor.
# Nunca la compartas ni la subas a GitHub.
SUPABASE_SECRET_KEY=tu_clave_secreta   # (también sirve el nombre SUPABASE_SERVICE_ROLE_KEY)

# Clave PÚBLICA (sb_publishable_… o anon): solo para iniciar sesión.
SUPABASE_PUBLISHABLE_KEY=tu_clave_publica

# Correo(s) con acceso al panel /admin, separados por coma
ADMIN_EMAILS=tu-correo@ejemplo.com

# WhatsApp del negocio: código de país + número, sin espacios ni "+" (ej. 59170000000)
WHATSAPP_NUMERO=591XXXXXXXX

# Radio en vivo (opcional). Enlace https directo de la señal, p. ej. https://stream.zeno.fm/xxxx
RADIO_URL=
RADIO_NOMBRE=Club Sonidero Tijuana

# Dirección pública de la tienda (opcional; en Vercel se detecta sola). Ej. https://janiwa.com
SITIO_URL=
